# Copia este archivo como ".env" y rellena tus valores reales.
# El archivo ".env" NUNCA se sube a internet.

MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@cluster0.xxxxx.mongodb.net/?appName=Cluster0
DB_NAME=manillas_co
COLLECTION=productos
PORT=5000
ADMIN_KEY=cambia-esta-llave-por-una-larga-y-unica
DEBUG=0

# --- Fotos del catalogo (opcionales: estos son los valores por defecto) ---
# Peso maximo de una foto al subirla, en MB
MAX_UPLOAD_MB=12
# La foto se reduce a este ancho para que la pagina cargue rapido
ANCHO_MAXIMO=1400
# Calidad del JPEG al guardar (85 = muy buena, 70 = mas ligera)
CALIDAD_JPEG=85

# Sitios autorizados a llamar a la API (separados por comas).
# Ejemplo: https://tu-sitio.netlify.app
# Con * acepta cualquier sitio (solo para pruebas).
CORS_ORIGINS=*